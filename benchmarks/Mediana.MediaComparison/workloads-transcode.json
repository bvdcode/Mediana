[
  {
    "id": "avc-transcode-30m",
    "input": "video-30m.mp4",
    "output_extension": ".ts",
    "description": "Full 1800-second 1280x720p24 software transcode, video only: constrained baseline, 10 Mbit/s target, 20 Mbit buffer; decoded source PSNR recorded separately; quality is not assumed equal",
    "mediana": {
      "environment": {},
      "output": "{output}",
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--video-codec",
        "H264",
        "--video-only",
        "--qp",
        "26",
        "--video-bit-rate",
        "10000000",
        "--video-buffer-ms",
        "2000",
        "--log-level",
        "Error",
        "--no-color"
      ]
    },
    "alternative": {
      "environment": {},
      "output": "{output}",
      "tool": "ffmpeg",
      "arguments": [
        "-nostdin",
        "-v",
        "error",
        "-xerror",
        "-threads",
        "2",
        "-i",
        "{input}",
        "-map",
        "0:v:0",
        "-an",
        "-c:v",
        "libx264",
        "-threads",
        "2",
        "-preset",
        "veryfast",
        "-profile:v",
        "baseline",
        "-level:v",
        "4.1",
        "-pix_fmt",
        "yuv420p",
        "-b:v",
        "10000000",
        "-maxrate",
        "10000000",
        "-bufsize",
        "20000000",
        "-g",
        "48",
        "-keyint_min",
        "48",
        "-sc_threshold",
        "0",
        "-fps_mode",
        "passthrough",
        "-mpegts_copyts",
        "1",
        "-output_ts_offset",
        "1",
        "-muxdelay",
        "0",
        "-f",
        "mpegts",
        "{output}"
      ]
    }
  }
]
