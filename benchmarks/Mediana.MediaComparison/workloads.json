[
  {
    "id": "heic-photo-12mp",
    "input": "photo-12mp.heic",
    "output_extension": ".rgba",
    "description": "Real 4000x3000 HEIC photograph, primary image decode to source-color RGBA8; no ICC transform or PNG encoder",
    "mediana": {
      "tool": "mediana_heif",
      "arguments": [
        "{input}",
        "{output}"
      ],
      "environment": {}
    },
    "alternative": {
      "tool": "heif_reference",
      "arguments": [
        "{input}",
        "{output}"
      ],
      "environment": {
        "LD_LIBRARY_PATH": "{heif_libraries}"
      }
    }
  },
