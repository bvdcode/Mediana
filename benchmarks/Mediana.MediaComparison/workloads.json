  {
    "id": "flac-sustained",
    "input": "stress-10m.flac",
    "output_extension": ".wav",
    "description": "Complete 600-second 48 kHz stereo synthetic FLAC stress stream to PCM16 WAVE",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
      ],
      "environment": {}
    },
    "alternative": {
      "tool": "ffmpeg",
      "arguments": [
        "-nostdin",
        "-v",
        "error",
        "-xerror",
        "-threads",
        "2",
        "-i",
        "{input}",
        "-map",
        "0:a:0",
        "-vn",
        "-c:a",
        "pcm_s16le",
        "-threads",
        "2",
        "{output}"
      ],
      "environment": {}
    }
  },
