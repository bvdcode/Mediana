  {
    "id": "jpeg-photo",
    "input": "photo-baseline.jpg",
    "output_extension": ".png",
    "description": "jpeg-photo",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "ffmpeg",
      "arguments": [
        "-nostdin",
        "-v",
        "error",
        "-xerror",
        "-threads",
        "2",
        "-i",
        "{input}",
        "-frames:v",
        "1",
        "-threads",
        "2",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
  },
