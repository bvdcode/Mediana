  {
    "id": "flac-track",
    "input": "soundtrack.flac",
    "output_extension": ".wav",
    "description": "Complete 596-second real stereo film soundtrack, PCM16 WAVE",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "ffmpeg",
      "arguments": [
        "-nostdin",
        "-v",
        "error",
        "-xerror",
        "-threads",
        "2",
        "-i",
        "{input}",
        "-map",
        "0:a:0",
        "-vn",
        "-c:a",
        "pcm_s16le",
        "-threads",
        "2",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
  },
  {
    "id": "aac-multichannel",
    "input": "soundtrack.m4a",
    "output_extension": ".wav",
    "description": "Complete real 596-second AAC-LC 5.1 film soundtrack in MP4/M4A to PCM16 WAVE",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
