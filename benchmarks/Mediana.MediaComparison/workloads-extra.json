  {
    "id": "jpeg-photo",
    "input": "photo-baseline.jpg",
    "output_extension": ".png",
    "description": "Complete JPEG/WebP decode and RGBA8 PNG export; native libjpeg-turbo/libwebp via Pillow, bilinear chroma reconstruction",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "python3",
      "arguments": [
        "benchmarks/Mediana.MediaComparison/pillow_reference.py",
        "{input}",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
