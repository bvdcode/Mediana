  {
    "id": "webp-encode",
    "input": "large-alpha.png",
    "output_extension": ".webp",
    "description": "Full-size photograph with alpha, Lossless WebP encoding; PNG load and output write included",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
