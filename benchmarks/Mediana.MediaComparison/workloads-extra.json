        "Lossless"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "cwebp",
      "arguments": [
        "-quiet",
        "-mt",
        "-exact",
        "-lossless",
        "-q",
        "75",
        "{input}",
        "-o",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
