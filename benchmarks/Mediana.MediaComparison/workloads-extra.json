        "2",
        "-i",
        "{input}",
        "-map",
        "0:a:0",
        "-vn",
        "-c:a",
        "pcm_s16le",
        "-threads",
        "2",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
  },
  {
    "id": "audio-resample",
    "input": "long-session.mp3",
    "output_extension": ".pcm",
    "description": "Complete 2460.096-second stereo MP3 to mono PCM16LE, 48 kHz to 16 kHz",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "audio",
        "resample",
        "{input}",
        "{output}",
        "--sample-rate",
        "16000",
        "--log-level",
        "Error",
        "--no-color",
        "--gains",
        "0.5",
        "0.5"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "ffmpeg",
      "arguments": [
        "-nostdin",
        "-v",
        "error",
        "-xerror",
        "-threads",
        "2",
        "-i",
        "{input}",
        "-af",
        "pan=mono|c0=0.5*c0+0.5*c1,aresample=16000",
        "-c:a",
        "pcm_s16le",
        "-threads",
        "2",
        "-f",
        "s16le",
        "{output}"
      ],
      "environment": {},
      "output": "{output}"
    }
  },
  {
