  {
    "id": "word-page",
    "input": "report-page.docx",
    "output_extension": ".png",
    "description": "Authored fixed-font document; first page/slide at 96 DPI",
    "mediana": {
      "tool": "mediana",
      "arguments": [
        "-i",
        "{input}",
        "{output}",
        "--log-level",
        "Error",
        "--no-color"
      ],
      "environment": {},
      "output": "{output}"
    },
    "alternative": {
      "tool": "lo_binary",
      "arguments": [
        "-env:UserInstallation={profile_uri}",
        "--headless",
        "--convert-to",
        "png:writer_png_Export:{{\"PixelWidth\":{{\"type\":\"long\",\"value\":815}},\"PixelHeight\":{{\"type\":\"long\",\"value\":1055}},\"PageNumber\":{{\"type\":\"long\",\"value\":1}}}}",
        "--outdir",
        "{output_directory}",
        "{input}"
      ],
      "environment": {
        "SAL_USE_VCLPLUGIN": "svp"
      },
      "output": "{output_directory}/{input_stem}.png"
    }
  },
