<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Authors>Vadim Belov</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/bvdcode/Mediana</RepositoryUrl>
    <Description>Managed multimedia building blocks for .NET.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EasyExtensions.Analyzers" Version="3.0.92" PrivateAssets="all" />
  </ItemGroup>
</Project>
